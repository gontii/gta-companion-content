{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gta-companion-content-updater",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "CONTENT_COORDINATOR", "class_name": "ContentCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContentCoordinator"] }],
  "kv_namespaces": [{ "binding": "CONTENT_KV", "id": "1265f18b80334dfe94517680b3eb6942" }],
  "ai": { "binding": "AI" },
  "vars": { "PUBLICATION_MODE": "publish" }
}
